# Token of the one master/builder bot created in @BotFather
BUILDER_BOT_TOKEN=123456789:replace_me

# Telegram user IDs that administer the builder itself (comma separated)
SUPER_ADMIN_IDS=123456789

# Generate with: python scripts/generate_key.py
TOKEN_ENCRYPTION_KEY=replace_with_fernet_key

# Local development. For PostgreSQL use:
# postgresql+asyncpg://user:password@host:5432/database
DATABASE_URL=sqlite+aiosqlite:///./data/store_builder.db

# Public HTTPS URL is required only for Zarinpal callbacks.
PUBLIC_BASE_URL=https://example.com
WEB_HOST=0.0.0.0
WEB_PORT=8080

TRIAL_DAYS=7
SUBSCRIPTION_DAYS=30
MONTHLY_SUBSCRIPTION_PRICE_TOMAN=100000
CUSTOMER_SETUP_PRICE_TOMAN=100000
REFERRAL_REWARD_TOMAN=20000

# Builder-level card-to-card settings (for subscriptions)
BUILDER_CARD_NUMBER=
BUILDER_CARD_HOLDER=
BUILDER_SUPPORT_ACCOUNT=@support

# production | development | test
APP_ENV=development
LOG_LEVEL=INFO

